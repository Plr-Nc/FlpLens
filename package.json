{
  "name": "flplens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only offline viewer for FL Studio projects",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inline.mjs",
    "build:static": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test test/parse.test.mjs",
    "verify": "node scripts/verify.mjs",
    "fixture": "node scripts/make-fixture.mjs test/fixtures/minimal/sample.flp",
    "demo": "node scripts/make-demo.mjs docs/demo.flp",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "author": "Plr-Nc",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/Plr-Nc/FlpLens.git",
    "type": "git"
  },
  "homepage": "https://github.com/Plr-Nc/FlpLens",
  "bugs": {
    "url": "https://github.com/Plr-Nc/FlpLens/issues"
  },
  "keywords": [
    "fl-studio",
    "flp",
    "daw",
    "viewer",
    "offline"
  ]
}
